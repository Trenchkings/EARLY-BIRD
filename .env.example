NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Mainnet StonkFun launch transport. Leave these unset on Devnet. Supply only
# provider-verified endpoints; EARLY BIRD deliberately does not guess them.
# STONKFUN_PREPARE_URL=
# STONKFUN_SUBMIT_URL=
# STONKFUN_STATUS_URL=
# STONKFUN_TIMEOUT_MS=12000

# For a controlled mainnet launch, set BOTH values explicitly. The server checks
# the RPC genesis hash before preparing a transaction.
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_SOLANA_RPC=https://your-verified-mainnet-rpc.example
